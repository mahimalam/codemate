# AI Code IDE - Environment Variables
# Copy this file to .env and fill in values.
# .env is gitignored and NEVER committed.

# Server bind address and port (optional overrides)
# HOST=127.0.0.1
# PORT=7860

# Optional: pre-set API keys via environment instead of the UI
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-...
