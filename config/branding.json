{
  "_comment": "Edit this file to fully customize the IDE branding, name, and defaults.",

  "app": {
    "name": "CodeMate",
    "short_name": "CodeMate",
    "tagline": "Your AI coding workspace",
    "version": "2.6.0",
    "author": "mahimalam",
    "github_url": "https://github.com/mahimalam/codemate"
  },

  "agent": {
    "name": "CodeMate",
    "welcome_message": "CodeMate is ready",
    "input_placeholder": "Ask CodeMate about your project...",
    "terminal_prompt": "codemate $"
  },

  "server": {
    "host": "127.0.0.1",
    "port": 7860
  },

  "defaults": {
    "system_prompt_intro": "You are an expert agentic AI software engineer.",
    "editor_theme": "vs-dark",
    "editor_font_size": 13,
    "default_ai_provider": "ollama",
    "default_ai_model": "qwen2.5:14b"
  }
}
